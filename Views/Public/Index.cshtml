@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Home";

    var games = ViewBag.RecentGames as List<Project> ?? new List<Project>();
    var books = ViewBag.RecentBooks as List<Project> ?? new List<Project>();
    var websites = ViewBag.RecentWebsites as List<Project> ?? new List<Project>();
    var announcements = ViewBag.Announcements as List<Announcement> ?? new List<Announcement>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/public/index.css" asp-append-version="true" />
}

<div class="home-index">

    <!-- HERO -->
    <header class="home-hero">

        <div class="hero-ornament hero-ornament-left" aria-hidden="true">
            <span></span>
        </div>

        <div class="hero-ornament hero-ornament-right" aria-hidden="true">
            <span></span>
        </div>

        <div class="hero-meta">
            <span>Digital Archive</span>
            <span class="hero-meta-divider">◆</span>
            <span>Selected Works</span>
            <span class="hero-meta-divider">◆</span>
            <span>Est. 2021</span>
        </div>

        <p class="hero-kicker">Software · Games · Web · Writing</p>

        <h1 class="hero-title">
            Weronika
            <span>Michalek</span>
        </h1>

        <div class="hero-rule" aria-hidden="true">
            <span></span>
            <i>✦</i>
            <span></span>
        </div>

        <p class="hero-tagline">
            A collection of digital worlds, interactive experiences,
            websites, and stories built through code and imagination.
        </p>

        <div class="hero-actions">
            <a href="#selected-work" class="btn btn-primary">
                Explore the archive
            </a>

            <a asp-controller="Public" asp-action="About" class="btn btn-secondary">
                About me
            </a>
        </div>

    </header>


    <!-- ANNOUNCEMENTS -->
    @if (announcements.Any())
    {
        <section class="home-notices" aria-labelledby="announcements-heading">

            <div class="notice-heading">
                <span class="section-label">Latest notice</span>
                <span class="notice-line"></span>
            </div>

            <div class="announcements-list">
                @foreach (var item in announcements)
                {
                    <article class="announcement-card">

                        <div class="announcement-mark" aria-hidden="true">
                            <span>✦</span>
                        </div>

                        <div class="announcement-content">
                            <div class="announcement-topline">
                                <span class="announcement-date">
                                    @item.CreatedAt.ToString("MMMM d, yyyy")
                                </span>
                            </div>

                            <h2>@item.Title</h2>

                            @if (!string.IsNullOrWhiteSpace(item.Body))
                            {
                                <p>@item.Body</p>
                            }
                        </div>

                    </article>
                }
            </div>

        </section>
    }


    <!-- SELECTED WORK -->
    <section id="selected-work" class="home-work" aria-labelledby="selected-work-heading">

        <div class="section-intro">
            <div>
                <span class="section-label">The collection</span>

                <h2 id="selected-work-heading">
                    Selected Works
                </h2>
            </div>

            <p>
                A selection of projects spanning software development,
                interactive media, web design, and fiction.
            </p>
        </div>


        <!-- GAMES -->
        <section class="home-section work-section" aria-labelledby="games-heading">

            <div class="home-section-head">

                <div class="section-heading-group">
                    <span class="section-number">01</span>

                    <div>
                        <span class="section-label">Interactive</span>
                        <h3 id="games-heading">Games</h3>
                    </div>
                </div>

                <a asp-controller="Public"
                   asp-action="Games"
                   class="home-see-all">
                    View collection
                    <span aria-hidden="true">→</span>
                </a>

            </div>

            @if (!games.Any())
            {
                <p class="home-empty">No published games yet.</p>
            }
            else
            {
                <div class="project-grid">
                    @foreach (var project in games)
                    {
                        <a asp-controller="Public"
                           asp-action="Game"
                           asp-route-slug="@project.Slug"
                           class="project-card">

                            <div class="project-image-wrap">
                                <img class="project-image"
                                     src="@ProjectDisplayHelper.CoverOrPlaceholder(project)"
                                     alt="@project.Title" />

                                <span class="project-view">
                                    View project
                                </span>
                            </div>

                            <div class="project-content">

                                <span class="project-category">
                                    @ProjectDisplayHelper.TeaserSubtitle(project)
                                </span>

                                <h4>@project.Title</h4>

                                @if (!string.IsNullOrWhiteSpace(project.Summary))
                                {
                                    <p>@project.Summary</p>
                                }

                                <span class="project-arrow" aria-hidden="true">
                                    ↗
                                </span>

                            </div>

                        </a>
                    }
                </div>
            }

        </section>


        <!-- WEBSITES -->
        <section class="home-section work-section" aria-labelledby="websites-heading">

            <div class="home-section-head">

                <div class="section-heading-group">
                    <span class="section-number">02</span>

                    <div>
                        <span class="section-label">Digital</span>
                        <h3 id="websites-heading">Websites</h3>
                    </div>
                </div>

                <a asp-controller="Public"
                   asp-action="Websites"
                   class="home-see-all">
                    View collection
                    <span aria-hidden="true">→</span>
                </a>

            </div>

            @if (!websites.Any())
            {
                <p class="home-empty">No published websites yet.</p>
            }
            else
            {
                <div class="project-grid">
                    @foreach (var project in websites)
                    {
                        <a asp-controller="Public"
                           asp-action="Website"
                           asp-route-slug="@project.Slug"
                           class="project-card">

                            <div class="project-image-wrap">
                                <img class="project-image"
                                     src="@ProjectDisplayHelper.CoverOrPlaceholder(project)"
                                     alt="@project.Title" />

                                <span class="project-view">
                                    View project
                                </span>
                            </div>

                            <div class="project-content">

                                <span class="project-category">
                                    @ProjectDisplayHelper.TeaserSubtitle(project)
                                </span>

                                <h4>@project.Title</h4>

                                @if (!string.IsNullOrWhiteSpace(project.Summary))
                                {
                                    <p>@project.Summary</p>
                                }

                                <span class="project-arrow" aria-hidden="true">
                                    ↗
                                </span>

                            </div>

                        </a>
                    }
                </div>
            }

        </section>


        <!-- BOOKS -->
        <section class="home-section work-section" aria-labelledby="books-heading">

            <div class="home-section-head">

                <div class="section-heading-group">
                    <span class="section-number">03</span>

                    <div>
                        <span class="section-label">Written</span>
                        <h3 id="books-heading">Books</h3>
                    </div>
                </div>

                <a asp-controller="Public"
                   asp-action="Books"
                   class="home-see-all">
                    View collection
                    <span aria-hidden="true">→</span>
                </a>

            </div>

            @if (!books.Any())
            {
                <p class="home-empty">No published books yet.</p>
            }
            else
            {
                <div class="project-grid books-grid">
                    @foreach (var project in books)
                    {
                        <a asp-controller="Public"
                           asp-action="Book"
                           asp-route-slug="@project.Slug"
                           class="project-card book-project-card">

                            <div class="project-image-wrap">
                                <img class="project-image"
                                     src="@ProjectDisplayHelper.CoverOrPlaceholder(project)"
                                     alt="@project.Title" />

                                <span class="project-view">
                                    View book
                                </span>
                            </div>

                            <div class="project-content">

                                <span class="project-category">
                                    @ProjectDisplayHelper.TeaserSubtitle(project)
                                </span>

                                <h4>@project.Title</h4>

                                @if (!string.IsNullOrWhiteSpace(project.Summary))
                                {
                                    <p>@project.Summary</p>
                                }

                                <span class="project-arrow" aria-hidden="true">
                                    ↗
                                </span>

                            </div>

                        </a>
                    }
                </div>
            }

        </section>

    </section>


    <!-- ABOUT PREVIEW -->
    <section class="home-about-preview">

        <div class="about-preview-mark" aria-hidden="true">
            <span>✦</span>
        </div>

        <div class="about-preview-content">

            <span class="section-label">Behind the collection</span>

            <h2>
                Code, creativity,<br />
                and a little bit of chaos.
            </h2>

            <p>
                I'm a software developer and creative technologist interested
                in building things that sit somewhere between technology,
                storytelling, and interactive experiences.
            </p>

            <a asp-controller="Public"
               asp-action="About"
               class="text-link">
                Read more about me
                <span aria-hidden="true">→</span>
            </a>

        </div>

        <div class="about-preview-decoration" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
        </div>

    </section>


    <!-- FINAL CTA -->
    <section class="home-cta">

        <span class="section-label">End of the catalogue</span>

        <h2>
            Something worth<br />
            building?
        </h2>

        <p>
            Explore the archive, or get in touch if you'd like to
            work together.
        </p>

        <a asp-controller="Public"
           asp-action="About"
           class="btn btn-primary">
            Get in touch
        </a>

    </section>

</div>
@using PortfolioCMS.Models
@model ProjectDetailViewModel

@{
    Layout = "_PublicLayout";

    var project = Model.Project;
    ViewData["Title"] = project.Title;

    var tags = Model.Tags?.Any() == true
        ? Model.Tags
        : ProjectDisplayHelper.ParseTags(project.Tags);

    var meta = Model.WebsiteMeta
        ?? ProjectDisplayHelper.TryDeserialize<WebsiteMetadata>(project.Metadata)
        ?? new WebsiteMetadata();

    var coverSrc = ProjectDisplayHelper.CoverOrPlaceholder(
        project,
        "/images/general/placeholder.jpg"
    );
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/public/website-detail.css"
          asp-append-version="true" />
}

<section class="website-detail">
    <div class="container">

        <!-- Back navigation -->
        <nav class="detail-back" aria-label="Breadcrumb">
            <a href="/websites" class="back-link">
                <span class="back-arrow" aria-hidden="true">←</span>
                <span>Back to Websites</span>
            </a>

            <span class="breadcrumb-divider">/</span>
            <span class="breadcrumb-current">@project.Title</span>
        </nav>

        <!-- Project heading -->
        <header class="detail-header">

            <div class="detail-eyebrow">
                <span class="eyebrow-line"></span>
                <span>Digital Archive / Web Projects</span>

                @if (!string.IsNullOrWhiteSpace(meta.Year))
                {
                    <span class="eyebrow-year">@meta.Year</span>
                }
            </div>

            <h1 class="detail-title">@project.Title</h1>

            @if (!string.IsNullOrWhiteSpace(project.Summary))
            {
                <p class="detail-summary">@project.Summary</p>
            }

            <div class="detail-header-rule"></div>

        </header>

        <!-- Main project preview -->
        <section class="detail-preview" aria-label="Project preview">

            <div class="preview-browser-bar">

                <div class="browser-controls" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <div class="browser-address">
                    <span class="browser-lock" aria-hidden="true">◇</span>
                    <span>@project.Title</span>
                </div>

                <span class="browser-label">PROJECT PREVIEW</span>

            </div>

            <div class="preview-image">
                <img src="@coverSrc"
                     alt="Preview of @project.Title" />
            </div>

            <div class="preview-caption">
                <span>FIG. 01</span>
                <span>Project documentation and visual reference</span>
            </div>

        </section>

        <!-- Project information -->
        <div class="detail-content">

            <main class="detail-main">

                <div class="section-label">
                    <span class="section-number">01</span>
                    <span>Project Overview</span>
                </div>

                <h2 class="detail-section-title">
                    Behind the build
                </h2>

                @if (!string.IsNullOrWhiteSpace(project.Summary))
                {
                    <p class="detail-description">@project.Summary</p>
                }
                else
                {
                    <p class="detail-description">
                        Further details about this project will be added to the archive soon.
                    </p>
                }

                @if (tags.Any())
                {
                    <div class="detail-technologies">

                        <div class="section-label">
                            <span class="section-number">02</span>
                            <span>Technologies &amp; Skills</span>
                        </div>

                        <div class="detail-tags">
                            @foreach (var tag in tags)
                            {
                                <span class="detail-tag">@tag</span>
                            }
                        </div>

                    </div>
                }

                @if (Model.Images?.Any() == true)
                {
                    <div class="detail-gallery">

                        <div class="section-label">
                            <span class="section-number">03</span>
                            <span>Project Gallery</span>
                        </div>

                        <div class="detail-gallery-grid">
                            @foreach (var image in Model.Images)
                            {
                                <figure class="detail-gallery-item">
                                    <img src="@image.Url"
     alt="@(string.IsNullOrWhiteSpace(image.Alt) ? $"Project image for {project.Title}" : image.Alt)"
     loading="lazy" />
                                </figure>
                            }
                        </div>

                    </div>
                }

            </main>

            <!-- Project facts -->
            <aside class="detail-sidebar">

                <div class="sidebar-heading">
                    <span>ARCHIVE RECORD</span>
                    <span class="record-symbol" aria-hidden="true">✳</span>
                </div>

                <div class="sidebar-field">
                    <span class="field-label">Project</span>
                    <span class="field-value">@project.Title</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(meta.Year))
                {
                    <div class="sidebar-field">
                        <span class="field-label">Year</span>
                        <span class="field-value">@meta.Year</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(meta.Stack))
                {
                    <div class="sidebar-field">
                        <span class="field-label">Primary Stack</span>
                        <span class="field-value">@meta.Stack</span>
                    </div>
                }

                <div class="sidebar-field">
                    <span class="field-label">Category</span>
                    <span class="field-value">Web Development</span>
                </div>

                <div class="sidebar-actions">

                    @if (!string.IsNullOrWhiteSpace(meta.LiveUrl))
                    {
                        <a href="@meta.LiveUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="detail-button detail-button-primary">
                            Visit Live Website
                            <span aria-hidden="true">↗</span>
                        </a>
                    }

                    @if (Model.Buttons?.Any() == true)
                    {
                        @foreach (var button in Model.Buttons)
                        {
                            <a href="@button.Url"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="detail-button detail-button-secondary">
                                @button.Label
                                <span aria-hidden="true">↗</span>
                            </a>
                        }
                    }

                    <a href="/websites"
                       class="detail-button detail-button-secondary">
                        Explore All Websites
                        <span aria-hidden="true">→</span>
                    </a>

                </div>

            </aside>

        </div>

        <!-- Bottom navigation -->
        <footer class="detail-footer">

            <span class="footer-note">
                END OF RECORD — DIGITAL PROJECTS
            </span>

            <a href="/websites" class="footer-back">
                <span aria-hidden="true">←</span>
                Return to Website Archive
            </a>

        </footer>

    </div>
</section>
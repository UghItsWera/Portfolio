@using PortfolioCMS.Models
@model AboutContent

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "About";
}

@section Styles {
    <link rel="stylesheet" href="~/css/public/about.css" asp-append-version="true" />
}

<div class="about-page">

    <!-- =====================================================
         INTRODUCTION
         ===================================================== -->

    <section class="about-intro">

        <div class="about-intro-meta">
            <span>Archive Entry</span>
            <span>About</span>
            <span>01 / 01</span>
        </div>

        <div class="about-intro-grid">

            <div class="about-intro-content">

                <span class="section-label">
                    The person behind the work
                </span>

                <h1>
                    Weronika
                    <span>Michalek</span>
                </h1>

                <div class="about-bio">

                    @if (!string.IsNullOrEmpty(Model.Bio1))
                    {
                        <p class="about-lead">
                            @Model.Bio1
                        </p>
                    }

                    @if (!string.IsNullOrEmpty(Model.Bio2))
                    {
                        <p>
                            @Model.Bio2
                        </p>
                    }

                    @if (!string.IsNullOrEmpty(Model.Bio3))
                    {
                        <p>
                            @Model.Bio3
                        </p>
                    }

                </div>

                <div class="about-links">

                    @if (!string.IsNullOrEmpty(Model.LinkedInLink))
                    {
                        <a href="@Model.LinkedInLink"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-primary">
                            @(string.IsNullOrEmpty(Model.LinkedIn)
                                ? "LinkedIn"
                                : Model.LinkedIn)
                        </a>
                    }

                    @if (!string.IsNullOrEmpty(Model.CVDownload))
                    {
                        <a href="@Model.CVDownload"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-secondary">
                            @(string.IsNullOrEmpty(Model.CV)
                                ? "Download CV"
                                : Model.CV)
                        </a>
                    }

                </div>

            </div>


            <!-- PROFILE -->

            <div class="about-profile">

                <div class="profile-frame">

                    <div class="profile-frame-label">
                        <span>Portrait</span>
                        <span>2026</span>
                    </div>

                    <div class="profile-image-wrap">

                        @if (!string.IsNullOrEmpty(Model.ProfileImage))
                        {
                            <img src="@Model.ProfileImage"
                                 alt="Portrait of Weronika Michalek"
                                 class="profile-img" />
                        }
                        else
                        {
                            <div class="profile-img-placeholder">
                                <span>WM</span>
                            </div>
                        }

                    </div>

                    <div class="profile-caption">
                        <span>Developer &amp; Creative Technologist</span>
                        <span>Digital archive</span>
                    </div>

                </div>

            </div>

        </div>

        <div class="about-intro-rule" aria-hidden="true">
            <span></span>
            <i>✦</i>
            <span></span>
        </div>

    </section>


    <!-- =====================================================
         DETAILS
         ===================================================== -->

    <section class="about-details" aria-label="Contact information">

        <div class="about-details-inner">

            @if (!string.IsNullOrEmpty(Model.GithubLink))
            {
                <div class="detail-item">

                    <span class="detail-number">01</span>

                    <div>
                        <span class="detail-label">Github</span>

                        <a href="@Model.GithubLink"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="detail-value">
                            @Model.Github
                        </a>
                    </div>

                </div>
            }

            @if (!string.IsNullOrEmpty(Model.EmailAddress))
            {
                <div class="detail-item">

                    <span class="detail-number">02</span>

                    <div>
                        <span class="detail-label">Email</span>

                        <a href="mailto:@Model.EmailAddress"
                           class="detail-value">
                            @Model.EmailAddress
                        </a>
                    </div>

                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Location))
            {
                <div class="detail-item">

                    <span class="detail-number">03</span>

                    <div>
                        <span class="detail-label">Location</span>

                        <span class="detail-value">
                            @Model.Location
                        </span>
                    </div>

                </div>
            }

        </div>

    </section>


    <!-- =====================================================
         CONTACT
         ===================================================== -->

    <section class="about-contact">

        <div class="contact-heading">

            <div>
                <span class="section-label">Correspondence</span>

                <h2>
                    Let's make<br />
                    something.
                </h2>
            </div>

            <p>
                Whether you're interested in a collaboration, a project,
                or simply want to get in touch, you're welcome to send
                a message.
            </p>

        </div>


        <div class="contact-grid">

            <!-- CONTACT INFORMATION -->

            <div class="contact-info">

                <div class="contact-intro">
                    <span class="contact-index">Contact</span>

                    <p>
                        I'm always interested in hearing about new ideas,
                        creative projects, and interesting opportunities.
                    </p>
                </div>


                @if (!string.IsNullOrEmpty(Model.EmailAddress))
                {
                    <div class="contact-detail">

                        <div class="contact-detail-symbol">
                            ✉
                        </div>

                        <div>
                            <span class="detail-label">
                                Email
                            </span>

                            <a href="mailto:@Model.EmailAddress">
                                @Model.EmailAddress
                            </a>
                        </div>

                    </div>
                }


                @if (!string.IsNullOrEmpty(Model.Location))
                {
                    <div class="contact-detail">

                        <div class="contact-detail-symbol">
                            ◎
                        </div>

                        <div>
                            <span class="detail-label">
                                Location
                            </span>

                            <span>
                                @Model.Location
                            </span>
                        </div>

                    </div>
                }

            </div>


            <!-- CONTACT FORM -->

            <div class="contact-form-wrap">

                @if (TempData["ContactSuccess"] != null)
                {
                    <div class="contact-alert success">
                        @TempData["ContactSuccess"]
                    </div>
                }

                @if (TempData["ContactError"] != null)
                {
                    <div class="contact-alert error">
                        @TempData["ContactError"]
                    </div>
                }


                <form method="post"
                      action="/about/contact"
                      class="contact-form">

                    @Html.AntiForgeryToken()

                    <div class="field">

                        <label for="fullName">
                            Full Name
                        </label>

                        <input id="fullName"
                               type="text"
                               name="fullName"
                               placeholder="Your name"
                               autocomplete="name"
                               required />

                    </div>


                    <div class="field">

                        <label for="email">
                            Email Address
                        </label>

                        <input id="email"
                               type="email"
                               name="email"
                               placeholder="you@example.com"
                               autocomplete="email"
                               required />

                    </div>


                    <div class="field">

                        <label for="message">
                            Message
                        </label>

                        <textarea id="message"
                                  name="message"
                                  rows="6"
                                  placeholder="Tell me a little about your enquiry..."
                                  required></textarea>

                    </div>


                    <button type="submit"
                            class="btn btn-primary contact-submit">
                        Send message
                        <span aria-hidden="true">→</span>
                    </button>

                    <p class="contact-footnote">
                        I'll get back to you as soon as possible.
                    </p>

                </form>

            </div>

        </div>

    </section>

</div>
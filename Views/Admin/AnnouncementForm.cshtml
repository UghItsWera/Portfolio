@using PortfolioCMS.Models
@model Announcement

@{
    Layout = "_AdminLayout";
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Announcement" : "Edit Announcement";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/project-form.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <a href="/Admin/Announcements" class="back-link">← Back to Announcements</a>
        <h1>@(isNew ? "New Announcement" : "Edit Announcement")</h1>
    </div>
    <div class="page-actions">
        <button type="submit" form="announcement-form" class="btn-primary-admin">
            @(isNew ? "Create" : "Save Changes")
        </button>
    </div>
</div>

<form id="announcement-form" method="post" action="/Admin/Announcements/Save">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="card-admin form-section" style="max-width: 720px;">
        <h2 class="section-title">Details</h2>

        <div class="form-group">
            <label class="form-label">Title <span class="required">*</span></label>
            <input type="text" name="Title" value="@Model.Title" class="form-input" required
                   placeholder="Announcement title..." />
        </div>

        <div class="form-group">
            <label class="form-label">Body</label>
            <textarea name="Body" class="form-input form-textarea" rows="5"
                      placeholder="Announcement content...">@Model.Body</textarea>
        </div>
    </div>
</form>
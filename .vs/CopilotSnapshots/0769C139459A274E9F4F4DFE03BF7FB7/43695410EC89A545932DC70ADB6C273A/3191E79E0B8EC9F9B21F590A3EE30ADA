.games-section {
    .games-section {
    padding: 4rem 0 6rem;

    .games-header {
        margin-bottom: 3rem;

        .display-lg {
            margin-bottom: 0.75rem;
        }
    }

    .games-grid {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .game-card {
        background: var(--surface-container-lowest);
        border-radius: 0.25rem;
        overflow: hidden;
        box-shadow: var(--shadow-ambient);
        cursor: pointer;
        transition: box-shadow 0.3s ease;

        &:hover {
            box-shadow: 0px 16px 40px rgba(44, 22, 15, 0.1);
        }

        &.active {
            .card-collapsed {
                display: none;
            }

            .card-expanded {
                display: flex;
            }

            .card-expanded-image img {
                transform: scale(1.02);
            }
        }

        .card-collapsed {
            display: flex;
            align-items: center;
            gap: 1.25rem;
            padding: 1rem 1.25rem;
            transition: opacity 0.3s ease;

            .card-thumb {
                width: 80px;
                height: 60px;
                border-radius: 0.25rem;
                overflow: hidden;
                flex-shrink: 0;
                background: var(--surface-container-highest);

                img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                }
            }

            .card-collapsed-info {
                display: flex;
                flex-direction: column;
                gap: 0.4rem;

                .card-collapsed-title {
                    font-family: 'Noto Serif', serif;
                    font-size: 1rem;
                    font-weight: 600;
                    color: var(--on-surface);
                }
            }
        }

        .card-expanded {
            display: none;
            flex-direction: column;

            .card-expanded-image {
                position: relative;
                width: 100%;
                height: 360px;
                overflow: hidden;
                border-radius: 0.25rem 0.25rem 0 0;

                img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                    transition: transform 0.4s ease;
                }

                .card-badge {
                    position: absolute;
                    top: 1rem;
                    left: 1rem;
                    background: var(--tertiary-container);
                    color: var(--on-tertiary-container);
                    font-family: 'Work Sans', sans-serif;
                    font-size: 0.7rem;
                    font-weight: 600;
                    letter-spacing: 0.08em;
                    text-transform: uppercase;
                    padding: 0.3rem 0.7rem;
                    border-radius: 0.15rem;
                }
            }

            .card-expanded-body {
                padding: 1.5rem 1.75rem;
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                gap: 2rem;
                background: var(--surface-container-lowest);

                .card-expanded-main {
                    display: flex;
                    flex-direction: column;
                    gap: 0.75rem;
                    flex: 1;

                    & > div:first-child {
                        display: flex;
                        align-items: baseline;
                        justify-content: space-between;
                        gap: 1rem;
                    }

                    .card-expanded-title {
                        font-family: 'Noto Serif', serif;
                        font-size: 1.75rem;
                        font-weight: 700;
                        color: var(--on-surface);
                        line-height: 1.2;
                    }

                    .card-expanded-year {
                        font-family: 'Work Sans', sans-serif;
                        font-size: 0.875rem;
                        color: var(--on-surface-muted);
                        flex-shrink: 0;
                    }

                    .card-expanded-summary {
                        font-size: 0.9rem;
                        color: var(--on-surface-variant);
                        line-height: 1.6;
                        max-width: 600px;
                    }
                }

                .card-expanded-actions {
                    display: flex;
                    flex-direction: column;
                    gap: 0.5rem;
                    flex-shrink: 0;
                }
            }
        }
    }

    .empty-state {
        padding: 4rem 0;
        text-align: center;
    }

    @media (max-width: 768px) {
        .card-expanded-body {
            flex-direction: column;
            align-items: flex-start;
        }

        .card-expanded-image {
            height: 240px;
        }

        .card-expanded-actions {
            flex-direction: row;
            width: 100%;

            .btn {
                flex: 1;
                justify-content: center;
            }
        }
    }
}
